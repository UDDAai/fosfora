{
  "name": "Harlequin",
  "author": "E. T. Carter",
  "description": "A cut-crystal mandala of hard, flat facets. Where the rest of the family blurs, this keeps knife-sharp mirror seams: the folded field is quantised into diamond facets, each flat-shaded a single jewel hue with a bright bevel glinting at its edges. Inner and outer rings counter-rotate, so the diamond pattern shears and reshuffles as the stone slowly turns. Imported from shader.gallery (MIT).",
  "shader": "",
  "inputs": [
    {
      "type": "Float",
      "name": "segments",
      "default": 13.099999,
      "min": 4.0,
      "max": 18.0
    },
    {
      "type": "Float",
      "name": "facets",
      "default": 8.389999,
      "min": 2.0,
      "max": 12.0
    },
    {
      "type": "Float",
      "name": "counterSpin",
      "default": 0.31320003,
      "min": 0.0,
      "max": 0.6
    },
    {
      "type": "Float",
      "name": "bevel",
      "default": 0.86469996,
      "min": 0.2,
      "max": 2.5
    }
  ],
  "passes": [
    {
      "name": "main",
      "shader": "harlequin.wgsl",
      "scale": 1.0,
      "inputs": [],
      "prev_inputs": [],
      "iterations": 1,
      "feedback": false
    }
  ],
  "postprocess": {
    "enabled": true,
    "bloom_threshold": 0.8,
    "bloom_intensity": 0.35,
    "vignette": 0.3,
    "ca_intensity": 0.5,
    "grain_intensity": 0.5,
    "grain_rate": 24.0,
    "bloom_enabled": false,
    "ca_enabled": false,
    "vignette_enabled": false,
    "grain_enabled": false,
    "tonemap": "linear"
  },
  "particles": null,
  "audio_mappings": [],
  "hidden": false
}