{
    "name": "Tally",
    "author": "E. T. Carter",
    "description": "An LED dot-matrix board running like a spectrum meter \u2014 columns of round LEDs bouncing to their own rhythm with peak-hold caps, lit dots grading cool-to-warm by height over a faint dark grid of off pixels. Crisp, rhythmic, electronic. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "tally.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "cols",
            "default": 28.0,
            "min": 10.0,
            "max": 56.0
        },
        {
            "type": "Float",
            "name": "speed",
            "default": 1.0,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "dotSize",
            "default": 0.7,
            "min": 0.3,
            "max": 0.95
        },
        {
            "type": "Float",
            "name": "glowOff",
            "default": 0.12,
            "min": 0.0,
            "max": 0.4
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
