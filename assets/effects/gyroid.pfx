{
    "name": "Gyroid",
    "author": "E. T. Carter",
    "description": "A raymarched flight through a gyroid, a triply-periodic minimal surface that tiles all of space into one smooth interwoven labyrinth. The camera drifts forward through the lattice while the thickened surface glows volumetrically, shaded by its own normals, hue turning with depth and fading into fog. A true 3D engine rather than strokes on black, it fills the frame because it is a solid the eye flies through. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "gyroid.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "scale",
            "default": 0.8,
            "min": 0.8,
            "max": 5
        },
        {
            "type": "Float",
            "name": "thick",
            "default": 0,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "speed",
            "default": 0.19,
            "min": 0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "glow",
            "default": 0.48,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "warp",
            "default": 1,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "hue",
            "default": 1.16,
            "min": 0,
            "max": 2
        },
        {
            "type": "Float",
            "name": "fog",
            "default": 0.06,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "rotate",
            "default": 85,
            "min": -180,
            "max": 180
        },
        {
            "type": "Float",
            "name": "surface",
            "default": 1,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "edge",
            "default": 0.42,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "contour",
            "default": 1,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "twist",
            "default": 0,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "bias",
            "default": 0,
            "min": 0,
            "max": 1
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
