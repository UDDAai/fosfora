{
    "name": "Gauze",
    "author": "E. T. Carter",
    "description": "A node network seen through a shallow depth of field. Glow nodes are scattered through depth and linked by hairline threads, but only those near the focal plane resolve to sharp points - the nearer and farther ones swell into soft out-of-focus bokeh discs, big and faint with their light spread thin. The focal plane racks slowly back and forth so the whole web breathes in and out of focus, strands sharpening as others bloom into haze. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "gauze.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "cell",
            "default": 70.0,
            "min": 40.0,
            "max": 160.0
        },
        {
            "type": "Float",
            "name": "focus",
            "default": 0.05,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "dof",
            "default": 0.12,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "rack",
            "default": 0.18,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "reach",
            "default": 1.17,
            "min": 0.4,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "nodeSize",
            "default": 1.45,
            "min": 0.3,
            "max": 2.5
        },
        {
            "type": "Float",
            "name": "hue",
            "default": 2.0,
            "min": 0.0,
            "max": 3.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
