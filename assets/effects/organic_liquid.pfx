{
    "name": "OrganicLiquid",
    "author": "Fosfora",
    "description": "Flexi's expansive reaction-diffusion (shadertoy.com/view/4dcGW2, 2016). A chemical field diffuses through a two-pass blur and draws as blue-white filaments. Flow at 0.5 is the original step size. Bass adds a little growth. The mouse vortex is left out. Published on Shadertoy under CC BY-NC-SA 3.0.",
    "shader": "",
    "passes": [
        {
            "name": "state",
            "shader": "organic_liquid_state.wgsl",
            "feedback": true,
            "prev_inputs": ["blur_v"]
        },
        {
            "name": "blur_h",
            "shader": "organic_liquid_blur_h.wgsl",
            "feedback": false,
            "inputs": ["state"]
        },
        {
            "name": "blur_v",
            "shader": "organic_liquid_blur_v.wgsl",
            "feedback": true,
            "inputs": ["blur_h"]
        },
        {
            "name": "main",
            "shader": "organic_liquid.wgsl",
            "feedback": false,
            "inputs": ["state"]
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "flow",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    },
    "audio_mappings": [
        { "feature": "bass", "target": "growth" }
    ]
}
