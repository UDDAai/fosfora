{
    "name": "SG Mycelium",
    "author": "E. T. Carter",
    "description": "A hyphal network spreading through dark substrate, seen from above under a black light. Pale branching threads fork at acute angles with dark ground between them, each strand growing from its root behind a bright swollen tip, standing a while, then dying back as a new one sprouts. Pulses of bioluminescence stream along the threads over a soft combed haze of finer hyphae. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "sg_mycelium.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "scale",
            "default": 1.0,
            "min": 0.4,
            "max": 2.5
        },
        {
            "type": "Float",
            "name": "speed",
            "default": 1.0,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "twigs",
            "default": 0.8,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "glow",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "wander",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
