{
  "name": "Lode",
  "author": "E. T. Carter",
  "description": "A mine shaft sunk through ore-bearing rock, seen straight down the bore. Near-black FBM stone walls salted with tiny hash-scattered mineral glints, a few glowing ore veins threading the rock, and one warm waist of light — a stationary lamp band at fixed screen radius. The wall pours perpetually down the scale axis through the lamp toward a true-black focal depth at the centre. Imported from shader.gallery (MIT).",
  "shader": "",
  "inputs": [
    {
      "type": "Float",
      "name": "descentSpeed",
      "default": 0.24961998,
      "min": 0.02,
      "max": 0.45
    },
    {
      "type": "Float",
      "name": "glintDensity",
      "default": 0.39159998,
      "min": 0.1,
      "max": 1.0
    },
    {
      "type": "Float",
      "name": "lampDepth",
      "default": 0.6152,
      "min": 0.2,
      "max": 0.8
    },
    {
      "type": "Float",
      "name": "veinGlow",
      "default": 0.6126,
      "min": 0.1,
      "max": 1.2
    }
  ],
  "passes": [
    {
      "name": "main",
      "shader": "lode.wgsl",
      "scale": 1.0,
      "inputs": [],
      "prev_inputs": [],
      "iterations": 1,
      "feedback": false
    }
  ],
  "postprocess": {
    "enabled": true,
    "bloom_threshold": 0.8,
    "bloom_intensity": 0.35,
    "vignette": 0.3,
    "ca_intensity": 0.5,
    "grain_intensity": 0.5,
    "grain_rate": 24.0,
    "bloom_enabled": false,
    "ca_enabled": false,
    "vignette_enabled": false,
    "grain_enabled": false,
    "tonemap": "linear"
  },
  "particles": null,
  "audio_mappings": [],
  "hidden": false
}