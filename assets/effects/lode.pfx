{
    "name": "Lode",
    "author": "E. T. Carter",
    "description": "A mine shaft sunk through ore-bearing rock, seen straight down the bore. Near-black FBM stone walls salted with tiny hash-scattered mineral glints, a few glowing ore veins threading the rock, and one warm waist of light \u2014 a stationary lamp band at fixed screen radius. The wall pours perpetually down the scale axis through the lamp toward a true-black focal depth at the centre. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "lode.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "descentSpeed",
            "default": 0.14,
            "min": 0.02,
            "max": 0.45
        },
        {
            "type": "Float",
            "name": "glintDensity",
            "default": 0.5,
            "min": 0.1,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "lampDepth",
            "default": 0.45,
            "min": 0.2,
            "max": 0.8
        },
        {
            "type": "Float",
            "name": "veinGlow",
            "default": 0.9,
            "min": 0.1,
            "max": 1.2
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
