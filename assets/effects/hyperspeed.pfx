{
    "name": "Hyperspeed",
    "author": "E. T. Carter",
    "description": "The jump to lightspeed from the cockpit: stars pour out of a dim glowing core and stretch into motion-blurred streaks that lengthen toward the frame edges, three parallax layers of them at different speeds. Each streak carries a white-hot head trailing off into a palette tint, and the haze beneath them is smeared radially too, so the whole frame streams outward while the tunnel rolls slowly about its axis. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "hyperspeed.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "speed",
            "default": 1.0,
            "min": 0.0,
            "max": 4.0
        },
        {
            "type": "Float",
            "name": "density",
            "default": 1.0,
            "min": 0.1,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "streak",
            "default": 1.0,
            "min": 0.1,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "core",
            "default": 0.8,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "tint",
            "default": 0.7,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
