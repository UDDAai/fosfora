{
    "name": "Suffuse",
    "author": "E. T. Carter",
    "description": "A pastel wash that bleeds into itself \u2014 wide soft poles of opal blue, lilac, rose and mint drift so slowly they read as one suffused field, with a faint soap-bubble shimmer sweeping through. The softest, dreamiest member of the family. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "suffuse.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "driftSpeed",
            "default": 0.12,
            "min": 0.0,
            "max": 0.6
        },
        {
            "type": "Float",
            "name": "softness",
            "default": 1.35,
            "min": 0.6,
            "max": 2.5
        },
        {
            "type": "Float",
            "name": "shimmer",
            "default": 0.5,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "warp",
            "default": 0.6,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
