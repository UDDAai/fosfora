{
    "name": "Dreamland",
    "author": "Fosfora",
    "description": "Kali's Fractal Land (shadertoy.com/view/XsBXWt, 2013): a cartoon raymarched terrain, colored by normals with dark edges, a rotating sun, and a flight along the valley. Speed at 0.5 is the original pace. Bass opens the sun the way the original music channel did. The Nyan Cat cameo and the sound pass are left out. Published on Shadertoy under CC BY-NC-SA 3.0.",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "dreamland.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "speed",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "rates": ["speed"],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    },
    "audio_mappings": [
        { "feature": "bass", "target": "sun size" }
    ]
}
