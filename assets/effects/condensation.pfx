{
  "name": "Condensation",
  "author": "E. T. Carter",
  "description": "Frost creeping across a cold pane at night. Feathery dendrite fingers advance inward from every edge of the glass, veined and grainy, glinting where facets turn to the light, while the blurred street lights behind the pane scatter into a milky glow under the ice. The front creeps in and thaws back on a long cycle, and now and then a breath fogs a soft patch of the clear glass and clears again. Imported from shader.gallery (MIT).",
  "shader": "",
  "inputs": [
    {
      "type": "Float",
      "name": "reach",
      "default": 0.305,
      "min": 0.0,
      "max": 1.0
    },
    {
      "type": "Float",
      "name": "speed",
      "default": 1.8539999,
      "min": 0.0,
      "max": 3.0
    },
    {
      "type": "Float",
      "name": "feather",
      "default": 0.846,
      "min": 0.0,
      "max": 2.0
    },
    {
      "type": "Float",
      "name": "sparkle",
      "default": 1.042,
      "min": 0.0,
      "max": 2.0
    },
    {
      "type": "Float",
      "name": "breath",
      "default": 0.625,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "name": "main",
      "shader": "condensation.wgsl",
      "scale": 1.0,
      "inputs": [],
      "prev_inputs": [],
      "iterations": 1,
      "feedback": false
    }
  ],
  "postprocess": {
    "enabled": true,
    "bloom_threshold": 0.8,
    "bloom_intensity": 0.35,
    "vignette": 0.3,
    "ca_intensity": 0.5,
    "grain_intensity": 0.5,
    "grain_rate": 24.0,
    "bloom_enabled": false,
    "ca_enabled": false,
    "vignette_enabled": false,
    "grain_enabled": false,
    "tonemap": "linear"
  },
  "particles": null,
  "audio_mappings": [],
  "hidden": false
}