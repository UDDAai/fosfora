{
    "name": "Rust",
    "author": "E. T. Carter",
    "description": "A running-bond brick wall lit by a low sun. Every brick carries its own fired tone, size and mottle, arrises are chipped and corners crumbled, and the gritty mortar bed sits recessed so the sweeping light throws lit edges on one side of each joint and drops a shadow into the other. The camera drifts slowly along the courses as the sun angle turns. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "brick.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "scale",
            "default": 30,
            "min": 10,
            "max": 80
        },
        {
            "type": "Float",
            "name": "depth",
            "default": 1.2,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "wear",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "variation",
            "default": 1.0,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "sun",
            "default": 0.1,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
