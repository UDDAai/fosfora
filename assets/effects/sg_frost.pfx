{
    "name": "SG Frost",
    "author": "E. T. Carter",
    "description": "A cluster of frosted-glass forms drifting and merging \u2014 raymarched 3D glass that refracts and reflects a soft palette-tinted environment, its surface scattering light into a milky translucence with a broad satin sheen. Reads as real rendered glass filling the frame. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "sg_frost.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "flow",
            "default": 0.4,
            "min": 0.0,
            "max": 1.2
        },
        {
            "type": "Float",
            "name": "merge",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "frost",
            "default": 0.45,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "spread",
            "default": 0.9,
            "min": 0.2,
            "max": 1.4
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
