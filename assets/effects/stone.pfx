{
    "name": "Stone",
    "author": "E. T. Carter",
    "description": "Agate cross-section: the marbling field read as dense, nearly concentric mineral bands \u2014 filled slabs of deep palette colour cycling hue band-by-band like layered geology, parted by thin luminous fortification seams. A very slow settling drift keeps the slab perpetually growing and re-layering, banded stone lit from within. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "stone.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "drift",
            "default": 0.12,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "banding",
            "default": 1.0,
            "min": 0.2,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "scale",
            "default": 380,
            "min": 150,
            "max": 900
        },
        {
            "type": "Float",
            "name": "warp",
            "default": 0.8,
            "min": 0.0,
            "max": 2.5
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
