{
    "name": "Scales",
    "author": "E. T. Carter",
    "description": "The flank of a fish seen close: offset rows of rounded scales, each row overlapping the one behind it so only the lower arc of every scale shows, with a soft contact shadow under each overlap and a bright thread along every free edge. Scales grow toward the head, the rows foreshorten as the body turns away, and a slow flex runs down the flank tilting the scales so a band of iridescent highlights travels along it. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "scales.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "scale",
            "default": 11.0,
            "min": 4.0,
            "max": 30.0
        },
        {
            "type": "Float",
            "name": "overlap",
            "default": 0.64,
            "min": 0.5,
            "max": 0.75
        },
        {
            "type": "Float",
            "name": "gloss",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "flex",
            "default": 0.6,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "speed",
            "default": 0.5,
            "min": 0.0,
            "max": 3.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
