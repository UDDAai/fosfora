{
    "name": "SG Tide",
    "author": "E. T. Carter",
    "description": "A grid of dots rippling like an LED matrix under water \u2014 concentric waves from two sources swell and shrink each dot as they pass and cross, crests brightening through the palette while troughs sink to near-black. Crisp, kinetic, rhythmic. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "ripple.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "dots",
            "default": 30.0,
            "min": 12.0,
            "max": 64.0
        },
        {
            "type": "Float",
            "name": "speed",
            "default": 1.4,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "wavelength",
            "default": 1.0,
            "min": 0.2,
            "max": 2.5
        },
        {
            "type": "Float",
            "name": "amp",
            "default": 0.7,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
