{
    "name": "Damask",
    "author": "E. T. Carter",
    "description": "A brocade wallpaper of mirror-symmetric foliate medallions on a half-drop repeat. Each cell folds a noise field through an N-fold dihedral kaleidoscope into an ornate, perfectly symmetric motif; the deep jewel ground carries the pattern tone-on-tone like real damask while gold filigree outlines the ornament. Lit evenly across the whole frame, no dark midriff. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "damask.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "scale",
            "default": 150.0,
            "min": 60.0,
            "max": 320.0
        },
        {
            "type": "Float",
            "name": "fold",
            "default": 8.0,
            "min": 4.0,
            "max": 16.0
        },
        {
            "type": "Float",
            "name": "detail",
            "default": 0.6,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "drift",
            "default": 0.4,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "sway",
            "default": 0.4,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "morph",
            "default": 0.5,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "rotate",
            "default": 0.0,
            "min": -180.0,
            "max": 180.0
        },
        {
            "type": "Float",
            "name": "ground",
            "default": 1.0,
            "min": 0.3,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "gold",
            "default": 1.0,
            "min": 0.3,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "spacing",
            "default": -0.4,
            "min": -1.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
