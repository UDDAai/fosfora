{
    "name": "Boids",
    "author": "E. T. Carter",
    "description": "A murmuration streaming across the whole frame at dusk: hundreds of small swept-wing marks banking together, piling into dense clumps and thinning to open gaps as turning waves roll through the flock. Each bird flaps on its own clock and drags a fading motion trail, with three parallax depths from small fogged distant birds to large bright near ones. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "boids.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "speed",
            "default": 1.0,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "density",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "trail",
            "default": 1.0,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "size",
            "default": 1.0,
            "min": 0.4,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "turn",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
