{
    "name": "Ember",
    "author": "E. T. Carter",
    "description": "A sea of molten metal stretching to a horizon \u2014 a raymarched wavy surface that mirrors a hot forge sky, with emissive lava pooling in the troughs between cooling crests and sharp glints riding the swell. A flowing metal surface rather than an object. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "quench.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "flow",
            "default": 0.4,
            "min": 0.0,
            "max": 1.2
        },
        {
            "type": "Float",
            "name": "swell",
            "default": 0.6,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "heat",
            "default": 0.7,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "polish",
            "default": 0.7,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
