{
    "name": "Undertow",
    "author": "E. T. Carter",
    "description": "Concentric ripples from three drifting sources interfere into a standing wave field, rendered as glowing contour bands over a deep dark base and tinted by phase and position into a restrained rainbow. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "undertow.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "speed",
            "default": 1.0,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "wavelength",
            "default": 150.0,
            "min": 60.0,
            "max": 300.0
        },
        {
            "type": "Float",
            "name": "bands",
            "default": 1.6,
            "min": 0.5,
            "max": 4.0
        },
        {
            "type": "Float",
            "name": "glow",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 1.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
