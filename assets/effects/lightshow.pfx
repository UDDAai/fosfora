{
    "name": "Lightshow",
    "author": "E. T. Carter",
    "description": "A 1960s liquid light show: coloured oil and dyed water pressed between glass plates on an overhead projector and thrown onto the wall. Translucent lenses of oil drift, swell, touch and fuse into amoebas, overlaps deepen into mixed colour, and every outline carries a bright meniscus rim with a soft halo of thrown light, while the plate turns slowly on the wheel and the lamp breathes. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "lightshow.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "speed",
            "default": 0.35,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "size",
            "default": 1.0,
            "min": 0.3,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "merge",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "dye",
            "default": 1.0,
            "min": 0.2,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "lamp",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
