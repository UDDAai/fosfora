{
    "name": "Dendrite",
    "author": "E. T. Carter",
    "description": "Ice crystal growing across a cold dark pane. Seeds throw out stars of straight trunks, each trunk sprouts side branches at a fixed angle, each branch sprouts finer branchlets, and every one starts growing only when its parent tip has passed, so the fern envelope builds itself over time. The advancing tips glow, the settled crystal cools to frost white, and each star melts back and re-forms elsewhere. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "dendrite.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "arms",
            "default": 6,
            "min": 3,
            "max": 8
        },
        {
            "type": "Float",
            "name": "angle",
            "default": 60,
            "min": 25,
            "max": 85
        },
        {
            "type": "Float",
            "name": "density",
            "default": 1.0,
            "min": 0.4,
            "max": 2.5
        },
        {
            "type": "Float",
            "name": "growth",
            "default": 1.0,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "glow",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
