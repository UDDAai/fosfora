{
    "name": "Chamber",
    "author": "E. T. Carter",
    "description": "The three-mirror tube seen as wallpaper: a real kaleidoscope's triangular mirror chamber tiles the whole plane with reflected copies of one triangle, so the frame fills edge-to-edge with a repeating jewelled honeycomb instead of a single radial star. Coloured glass motes drift through the fundamental triangle while the lattice slowly slides and turns; cut-glass glints run the mirror seams. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "chamber.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "scale",
            "default": 3.5,
            "min": 1.5,
            "max": 7.0
        },
        {
            "type": "Float",
            "name": "driftSpeed",
            "default": 1.0,
            "min": 0.0,
            "max": 2.5
        },
        {
            "type": "Float",
            "name": "turnSpeed",
            "default": 0.08,
            "min": 0.0,
            "max": 0.4
        },
        {
            "type": "Float",
            "name": "glow",
            "default": 1.0,
            "min": 0.3,
            "max": 1.8
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
