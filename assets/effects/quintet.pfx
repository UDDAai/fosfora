{
    "name": "Quintet",
    "author": "E. T. Carter",
    "description": "Five standing plane-wave trains cross at 72 degrees and sum into a decagonal quasicrystal, rendered as luminous iso-contours: nested rings around every interference centre interlock into the pentagon and ten-pointed-star tiling of a pattern that never quite repeats, an ornate woven brocade of glowing thread. The contour hue cycles by field level so each ring shimmers a different colour. Hash-scheduled strikes flood all five voices and they ring down at five separate rates, so the whole weave flares on a strike and recedes between blows while the phases slowly breathe. A five-voice sibling of Triad's three-train honeycomb. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "quintet.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "cellSize",
            "default": 52,
            "min": 24,
            "max": 120
        },
        {
            "type": "Float",
            "name": "strikeGap",
            "default": 11,
            "min": 4,
            "max": 30
        },
        {
            "type": "Float",
            "name": "ringTime",
            "default": 7,
            "min": 2,
            "max": 13
        },
        {
            "type": "Float",
            "name": "skew",
            "default": 0.03,
            "min": 0.0,
            "max": 0.12
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
