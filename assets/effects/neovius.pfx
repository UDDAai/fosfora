{
    "name": "Neovius",
    "author": "E. T. Carter",
    "description": "A raymarched flight through a Neovius surface, a triply-periodic minimal surface of fat rounded pockets joined by narrow necks, softer and more bulbous than the gyroid or diamond. The camera drifts through while walls catch a soft light with topographic contour ribbing wrapping each pocket, hue turning with depth into fog. A sibling on the same 3D engine, with a warm organic character. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "neovius.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "scale",
            "default": 0.8,
            "min": 0.8,
            "max": 5
        },
        {
            "type": "Float",
            "name": "thick",
            "default": 0,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "speed",
            "default": 0.07,
            "min": 0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "glow",
            "default": 1,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "warp",
            "default": 1,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "hue",
            "default": 1.95,
            "min": 0,
            "max": 2
        },
        {
            "type": "Float",
