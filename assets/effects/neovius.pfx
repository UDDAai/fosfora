            "default": 0,
            "min": 0,
            "max": 1
        },
        {
            "type": "Float",
            "name": "rotate",
            "default": 0,
            "min": -180,
            "max": 180
        },
        {
            "type": "Float",
            "name": "surface",
            "default": 1,
            "min": 0,
            "max": 1
