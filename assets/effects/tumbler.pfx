{
    "name": "Tumbler",
    "author": "E. T. Carter",
    "description": "The feel of turning the tube: angular glass shards in the object cell that each tumble on their own axis while the mirror-fold reflects them. As the chips rotate and slide, the reflected figure keeps re-locking into fresh symmetric arrangements \u2014 the characteristic click-and-reshuffle of a kaleidoscope being turned, hard-edged chips of colour on near-black. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "tumbler.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "segments",
            "default": 7.0,
            "min": 3.0,
            "max": 16.0
        },
        {
            "type": "Float",
            "name": "tumbleSpeed",
            "default": 1.0,
            "min": 0.0,
            "max": 2.5
        },
        {
            "type": "Float",
            "name": "shardScale",
            "default": 1.0,
            "min": 0.4,
            "max": 2.5
        },
        {
            "type": "Float",
            "name": "rotateSpeed",
            "default": 0.12,
            "min": 0.0,
            "max": 0.5
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
