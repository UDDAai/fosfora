{
    "name": "Iris Ringed",
    "author": "E. T. Carter",
    "description": "A banded iris filling the frame: the radial fibers are crossed by glowing concentric annular rings that ripple slowly outward from a dark pupil, the way a real iris is scored by furrows and a collarette. Fibers give the fine radial grain, the rings a travelling annular lattice that catches a brighter tint where it crosses a fiber; colour blends through the palette by angle, the pupil a dark protagonist with a luminous rim. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "iris_ringed.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "fibers",
            "default": 150.0,
            "min": 60.0,
            "max": 300.0
        },
        {
            "type": "Float",
            "name": "rings",
            "default": 9.0,
            "min": 3.0,
            "max": 24.0
        },
        {
            "type": "Float",
            "name": "ripple",
            "default": 0.4,
            "min": -1.5,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "pupil",
            "default": 110.0,
            "min": 50.0,
            "max": 220.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
