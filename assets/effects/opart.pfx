{
    "name": "Opart",
    "author": "E. T. Carter",
    "description": "An op-art band illusion: hard black bands on near-white paper pushed through six invisible lenses, domes and dents that magnify the bands at their centre and crush them at the rim so straight lines bow into solid forms pressing through the print. Ink weight thickens on the shadow side of each dome, giving the false relief a false light, and the whole field breathes and drifts slowly. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "opart.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "density",
            "default": 44.0,
            "min": 8.0,
            "max": 80.0
        },
        {
            "type": "Float",
            "name": "bulge",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "breath",
            "default": 0.3,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "tilt",
            "default": 8.0,
            "min": -45.0,
            "max": 45.0
        },
        {
            "type": "Float",
            "name": "tint",
            "default": 0.35,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
