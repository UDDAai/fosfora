{
    "name": "Heartwood",
    "author": "E. T. Carter",
    "description": "The sawn end of a log: warm concentric growth rings and radial grain around an off-centre pith, with fire eating inward from the bark as a wandering annular ember rim graded warm-to-cool. Rings light as hairline preheat circles a beat before they burn; outside is ash with cooling sparks. The rim tightens to the pith and dies as a fresh face is already burning in. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "heartwood.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "burnRate",
            "default": 0.18,
            "min": 0.05,
            "max": 0.6
        },
        {
            "type": "Float",
            "name": "rimWidth",
            "default": 13.0,
            "min": 4.0,
            "max": 36.0
        },
        {
            "type": "Float",
            "name": "lobeWobble",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "ringRandom",
            "default": 0.4,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "ringWaver",
            "default": 0.4,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "preheat",
            "default": 0.4,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
