{
    "name": "Floret",
    "author": "E. T. Carter",
    "description": "A sunflower spiral of crisp dots \u2014 seeds placed on the golden angle so they pack into the interlocking Fermat spirals of phyllotaxis, colour grading outward by radius while a brightness pulse travels through the rings as the whole head turns. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "floret.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "spin",
            "default": 0.3,
            "min": 0.0,
            "max": 1.2
        },
        {
            "type": "Float",
            "name": "spacing",
            "default": 0.062,
            "min": 0.03,
            "max": 0.1
        },
        {
            "type": "Float",
            "name": "dotSize",
            "default": 0.62,
            "min": 0.3,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "pulse",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
