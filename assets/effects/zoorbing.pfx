{
    "name": "Zoorbing",
    "author": "Fosfora",
    "description": "whisky_shusuky's Octagrams (shadertoy.com/view/tlVGDt, 2020): a glowing tunnel of folding slabs. Speed at 0.5 is the original flight. Bass brightens the filaments. Published on Shadertoy under CC BY-NC-SA 3.0.",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "zoorbing.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "speed",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "rates": ["speed"],
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.55,
        "bloom_intensity": 0.35,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    },
    "audio_mappings": [
        { "feature": "bass", "target": "filament brightness" }
    ]
}
