{
    "name": "Black Hole",
    "author": "Fosfora",
    "description": "XorDev's black hole, from the MilkDrop port in XorPlayer. A slow swirl around a dark core, with a bright ring. Bass at the middle of the slider is the original resting level: it shifts the green and thickens the glow. Spin at the middle is the original speed. Bind a smoothed bass band to Bass; the shader does not read the FFT itself. Credit: XorDev (x.com/XorDev), MilkDrop port by MilkDrop2077.",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "black_hole.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "bass",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "spin",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "rates": ["spin"],
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.65,
        "bloom_intensity": 0.4,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    },
    "audio_mappings": [
        { "feature": "bass", "target": "bass slider, smoothed. Center of the slider is the original look" }
    ]
}
