{
    "name": "Halo",
    "author": "E. T. Carter",
    "description": "Total solar eclipse: a dark occulting moon hangs high against a slow-twinkling starfield while a bright corona blazes around its limb, its edge frayed by ridged noise into the filamental streamers and prominences of a real eclipse. A thin warm chromosphere rings the limb and a diamond-ring point flares at one side. The corona crawls slowly around the disc, the radius breathes, and the streamers shimmer \u2014 all very slow, nothing that resets. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "halo.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "haloRadius",
            "default": 200.0,
            "min": 120.0,
            "max": 460.0
        },
        {
            "type": "Float",
            "name": "fray",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "waverSpeed",
            "default": 0.18,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "starDensity",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "posX",
            "default": 0.4,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "posY",
            "default": 0.62,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
