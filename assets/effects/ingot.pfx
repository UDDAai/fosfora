{
    "name": "Ingot",
    "author": "E. T. Carter",
    "description": "A sheet of brushed metal catching the light \u2014 fine horizontal grooves scatter a broad anisotropic highlight that sweeps slowly across the surface, glinting along the brush lines. A close-up metal material rather than an object, filling the frame. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "ingot.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "sweepSpeed",
            "default": 0.35,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "brush",
            "default": 0.6,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "sheen",
            "default": 0.7,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "anisotropy",
            "default": 0.7,
            "min": 0.1,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "mouseInfluence",
            "default": 0.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
