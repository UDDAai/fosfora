{
    "name": "Rainglass",
    "author": "E. T. Carter",
    "description": "Rain on a window at night. Behind the fogged pane a dark street of defocused lights glows in soft bokeh discs; on the glass, runners fall in wiggling stalls and darts, leaving beaded trails and wiped streaks where the lights come back into focus, while small beads swell on the pane and vanish as a runner passes. Every drop is a lens showing the lit field sharp and inverted, with a dark rim and one tight highlight. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "rainglass.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "rain",
            "default": 1.0,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "speed",
            "default": 0.3,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "smear",
            "default": 0.6,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "fog",
            "default": 0.7,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "refract",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "lights",
            "default": 1.0,
            "min": 0.2,
            "max": 2.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
