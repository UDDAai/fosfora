{
    "name": "Chalk",
    "author": "E. T. Carter",
    "description": "A slate chalkboard mid-lesson: hand-drawn circles, triangles, hatch bundles and spirals chalked up stroke by stroke in white and palette-tinted pastel, with a dusty broken edge where the chalk catches the tooth of the slate. Each area is drawn, held, then wiped by an eraser pass that leaves a streaky dust ghost of the old marks, fading as the next set goes up. Dark stone ground with mottle, pits and a soft window light. Imported from shader.gallery (MIT).",
    "shader": "",
    "passes": [
        {
            "name": "main",
            "shader": "chalk.wgsl",
            "feedback": false
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "speed",
            "default": 1.0,
            "min": 0.0,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "scale",
            "default": 1.0,
            "min": 0.5,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "stroke",
            "default": 1.0,
            "min": 0.4,
            "max": 2.5
        },
        {
            "type": "Float",
            "name": "dust",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "colour",
            "default": 0.8,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "grain_enabled": false,
        "vignette_enabled": false,
        "tonemap": "linear"
    }
}
